# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (produção).
# Nada aqui é obrigatório para o app abrir: sem contas, ele funciona só no aparelho.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://domeni.app
NEXT_PUBLIC_SUPPORT_EMAIL=contato@domeni.app
NEXT_PUBLIC_INSTAGRAM=
# Obrigatórios para vender (Decreto 7.962/2013): aparecem no rodapé e nas páginas legais
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_CNPJ=
NEXT_PUBLIC_COMPANY_ADDRESS=

# --- Supabase (contas, sincronização, cotas) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- IA (Anthropic) ---
ANTHROPIC_API_KEY=
# Sua conta (IA sem limite, escolha de modelo, Plus de cortesia). Separe vários por vírgula.
OWNER_EMAILS=
# Teto de gasto da IA de todas as assinantes juntas no mês, em dólares (a sua conta não conta)
AI_MONTHLY_BUDGET_USD=60
# Modelos para quem assina (padrão: claude-haiku-5-5)
AI_MODEL=claude-haiku-5-5
AI_MODEL_SEARCH=claude-haiku-5-5
# Cotas por mês (padrão: grátis 5 ações; Plus 150 ações e 15 pesquisas)
AI_LIMIT_FREE=
AI_LIMIT_FREE_SEARCH=
AI_LIMIT_PLUS=
AI_LIMIT_PLUS_SEARCH=
# Código antigo de acesso à IA (opcional, só para usar sem conta)
DOMENI_ACCESS_CODE=

# --- Stripe (site) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION=
# 1 depois de ativar o Pix no Stripe
STRIPE_PIX=

# --- Brevo (lista de espera) ---
BREVO_API_KEY=
BREVO_LIST_ID=

# --- Lojas (RevenueCat) ---
REVENUECAT_WEBHOOK_AUTH=
NEXT_PUBLIC_REVENUECAT_IOS_KEY=
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=

# --- Só no build das lojas (npm run build:native) ---
# NEXT_PUBLIC_API_BASE=https://domeni.app
